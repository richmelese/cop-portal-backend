generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Page {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  eyebrow       String
  sectionLabel  String
  sectionHref   String?
  summary       String
  image         String   @default("night")
  tagline       String?
  note          String?
  showWeather   Boolean  @default(false)
  visitor       Boolean  @default(false)
  visitorLabel  String?
  sections      Json
  timeline      Json?
  stats         Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NewsPost {
  id        String   @id @default(cuid())
  category  String
  date      String
  title     String
  excerpt   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqEntry {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Leader {
  id        String   @id @default(cuid())
  tag       String
  name      String
  role      String
  quote     String
  image     String?
  color     String   @default("navy")
  // "pm" = featured in the homepage hero Leader Quote section; "leader" = shown only
  // in the "COP32 Leaders" carousel. At most one leader should be "pm" at a time.
  displayAs String   @default("leader")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Key-value store for admin-uploaded images used by otherwise-static homepage
// sections (e.g. the "COP32 Areas" illustration) — one row per replaceable image.
model SiteAsset {
  key       String   @id
  url       String
  updatedAt DateTime @updatedAt
}

// The homepage "COP32 Areas" section's Blue Zone / Green Zone cards — a fixed pair
// (key "blue" | "green"), each holding its editable copy and bullet list.
model ConferenceZone {
  key         String   @id
  name        String
  tone        String   @default("navy")
  description String
  note        String
  items       Json
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}
